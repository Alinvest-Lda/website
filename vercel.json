{
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/areas/normas-iso",
      "destination": "/detalhe.html"
    },
    {
      "source": "/areas/sshe-hst",
      "destination": "/detalhe.html"
    },
    {
      "source": "/areas/recursos-humanos",
      "destination": "/detalhe.html"
    },
    {
      "source": "/areas/financas",
      "destination": "/detalhe.html"
    },
    {
      "source": "/areas/governanca",
      "destination": "/detalhe.html"
    },
    {
      "source": "/areas/risco-compliance",
      "destination": "/detalhe.html"
    },
    {
      "source": "/formacoes/individual",
      "destination": "/detalhe.html"
    },
    {
      "source": "/formacoes/equipas",
      "destination": "/detalhe.html"
    },
    {
      "source": "/solucoes/iso-performance",
      "destination": "/detalhe.html"
    },
    {
      "source": "/solucoes/sshe-hst",
      "destination": "/detalhe.html"
    },
    {
      "source": "/solucoes/compliance-gestao-riscos",
      "destination": "/detalhe.html"
    },
    {
      "source": "/solucoes/fpa-intelligence-analytics",
      "destination": "/detalhe.html"
    },
    {
      "source": "/solucoes/melhoria-gestao-operacional",
      "destination": "/detalhe.html"
    },
    {
      "source": "/actualizacoes/conteudos-praticos-gestao",
      "destination": "/detalhe.html"
    },
    {
      "source": "/actualizacoes/sistemas-gestao-melhoria",
      "destination": "/detalhe.html"
    },
    {
      "source": "/actualizacoes/trabalhos-organizacoes",
      "destination": "/detalhe.html"
    },
    {
      "source": "/actualizacoes/capacitacoes-eventos",
      "destination": "/detalhe.html"
    },
    {
      "source": "/privacidade",
      "destination": "/politica-de-privacidade.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
