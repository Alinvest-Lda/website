{
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/privacidade",
      "destination": "/politica-de-privacidade.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests; img-src 'self' https://images.pexels.com data: blob:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; connect-src 'self'"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contacto",
      "permanent": true
    },
    {
      "source": "/case-studies",
      "destination": "/actualizacoes/trabalhos-organizacoes",
      "permanent": true
    },
    {
      "source": "/service/iso-implementation-auditing",
      "destination": "/solucoes/iso-performance",
      "permanent": true
    },
    {
      "source": "/service/hseq-implementation-auditing",
      "destination": "/solucoes/sshe-hst",
      "permanent": true
    },
    {
      "source": "/service/trainings-capacity-building",
      "destination": "/formacoes/equipas",
      "permanent": true
    },
    {
      "source": "/service/business-consulting",
      "destination": "/solucoes/melhoria-gestao-operacional",
      "permanent": true
    }
  ]
}
